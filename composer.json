{
	"name": "spaze/psalm-plugin-nette",
	"description": "Psalm plugin for Nette: tells the unused code detection what Nette, Nette Tester and the DI container call",
	"license": "MIT",
	"type": "psalm-plugin",
	"keywords": [
		"psalm",
		"psalm-plugin",
		"nette",
		"static analysis",
		"dead code"
	],
	"authors": [
		{
			"name": "Michal Špaček",
			"homepage": "https://www.michalspacek.com/"
		}
	],
	"require": {
		"php": "^8.2",
		"nette/neon": "^3.3",
		"psalm/psalm-plugin-api": "^0.5"
	},
	"require-dev": {
		"codeception/codeception": "^5.0",
		"latte/latte": "^3.0",
		"nette/application": "^3.2",
		"nette/http": "^3.3",
		"nette/security": "^3.2",
		"nette/tester": "^2.7",
		"php-parallel-lint/php-console-highlighter": "^1.0",
		"php-parallel-lint/php-parallel-lint": "^1.3",
		"phpstan/phpstan": "^2.2",
		"phpstan/phpstan-strict-rules": "^2.0",
		"spaze/coding-standard": "^1.9",
		"spaze/phpcs-phar": "^4.0",
		"spaze/phpstan-disallowed-calls": "^4.5",
		"vimeo/psalm": "^7.12",
		"weirdan/codeception-psalm-module": "^0.14.2"
	},
	"conflict": {
		"psalm/phar": "<7.12"
	},
	"config": {
		"sort-packages": true
	},
	"extra": {
		"psalm": {
			"pluginClass": "Spaze\\Psalm\\Nette\\Plugin"
		}
	},
	"autoload": {
		"psr-4": {
			"Spaze\\Psalm\\Nette\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Spaze\\Psalm\\Nette\\Tests\\": [
				"tests/_support",
				"tests"
			]
		}
	},
	"scripts": {
		"acceptance": [
			"vendor/bin/codecept build",
			"vendor/bin/codecept run acceptance"
		],
		"acceptance-phar": [
			"@composer --working-dir=tests/_phar update --no-progress",
			"vendor/bin/codecept build",
			"vendor/bin/codecept run acceptance --env phar"
		],
		"cs-fix": "vendor/bin/phpcbf src/ tests/",
		"lint": "vendor/bin/parallel-lint --colors --exclude tests/_phar --exclude tests/_run src/ tests/",
		"phpcs": "vendor/bin/phpcs src/ tests/",
		"phpstan": [
			"vendor/bin/codecept build",
			"vendor/bin/phpstan -vvv --ansi analyse --configuration phpstan.neon"
		],
		"psalm": [
			"vendor/bin/codecept build",
			"vendor/bin/psalm"
		],
		"test": [
			"@lint",
			"@phpcs",
			"@phpstan",
			"@psalm",
			"@acceptance",
			"@acceptance-phar"
		]
	}
}
