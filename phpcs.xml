<?xml version="1.0"?>
<ruleset name="PsalmPluginNette">
	<arg name="extensions" value="php"/>
	<arg name="cache"/>
	<arg name="colors"/>
	<arg value="s"/>
	<arg value="p"/>
	<exclude-pattern>tests/_output/</exclude-pattern>
	<exclude-pattern>tests/_phar/</exclude-pattern>
	<exclude-pattern>tests/_run/</exclude-pattern>
	<exclude-pattern>tests/_support/_generated/</exclude-pattern>
	<rule ref="vendor/spaze/coding-standard/src/ruleset.xml">
		<exclude name="SlevomatCodingStandard.TypeHints.ClassConstantTypeHint"/> <!-- Typed class constants need PHP 8.3 -->
	</rule>
</ruleset>
